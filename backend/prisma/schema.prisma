generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MainCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  icons       Icon[]
  timePeriods TimePeriod[]
}

model TimePeriod {
  id             Int          @id @default(autoincrement())
  name           String
  order          Int?
  mainCategoryId Int
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id])
  icons          Icon[]

  @@unique([name, mainCategoryId])
}

model User {
  id                  Int          @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String       @unique
  passwordHash        String
  salt                String
  condition           String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  sentAacMessages     AacMessage[] @relation("AacMessageSender")
  receivedAacMessages AacMessage[] @relation("AacMessageReceiver")
}

model Icon {
  id             Int          @id @default(autoincrement())
  title          String
  expression     String
  imageUrl       String
  category       String
  audioUrl       String?
  mainCategoryId Int
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id])
  timePeriodId   Int?
  timePeriod     TimePeriod?  @relation(fields: [timePeriodId], references: [id])
  subIcons       SubIcon[]

  @@unique([title])
}

model EmergencyNumber {
  id     Int     @id @default(autoincrement())
  number String  @unique
  label  String?
}

model AacMessage {
  id          Int      @id @default(autoincrement())
  senderName  String
  message     String
  source      String   @default("aac")
  senderPhone String?
  externalId  String?
  senderId    Int?
  receiverId  Int?
  sender      User?    @relation("AacMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  receiver    User?    @relation("AacMessageReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([receiverId, createdAt])
  @@index([senderId, createdAt])
}

model SpeechAttempt {
  id         Int      @id @default(autoincrement())
  word       String
  transcript String
  score      Int
  createdAt  DateTime @default(now())

  @@index([word])
}

model SubIcon {
  id          Int          @id @default(autoincrement())
  title       String
  expression  String
  imageUrl    String
  category    String
  audioUrl    String?
  iconId      Int
  icon        Icon         @relation(fields: [iconId], references: [id])
  subSubIcons SubSubIcon[]

  @@unique([title, iconId])
}

model SubSubIcon {
  id         Int     @id @default(autoincrement())
  title      String
  expression String
  imageUrl   String
  category   String
  audioUrl   String?
  subIconId  Int
  subIcon    SubIcon @relation(fields: [subIconId], references: [id])

  @@unique([title, subIconId])
}
